generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USER ──────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("TENANT") // TENANT | LANDLORD | ADMIN
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantProfile  TenantProfile?
  landlordProfile LandlordProfile?

  // Landlord relations
  ownedProperties    Property[]
  receivedInquiries  Inquiry[]           @relation("LandlordInquiries")
  landlordConversations Conversation[]   @relation("LandlordConversations")
  landlordVisits     VisitRequest[]      @relation("LandlordVisits")
  landlordApplications RentalApplication[] @relation("LandlordApplications")
  landlordTenancies  Tenancy[]           @relation("LandlordTenancies")

  // Tenant relations
  favorites          Favorite[]
  sentInquiries      Inquiry[]           @relation("TenantInquiries")
  tenantConversations Conversation[]     @relation("TenantConversations")
  sentMessages       Message[]
  tenantVisits       VisitRequest[]      @relation("TenantVisits")
  tenantApplications RentalApplication[] @relation("TenantApplications")
  tenantTenancies    Tenancy[]           @relation("TenantTenancies")
  maintenanceRequests MaintenanceRequest[]
  maintenanceNotes   MaintenanceNote[]
  payments           Payment[]

  // Common
  notifications      Notification[]
  reports            Report[]
  auditLogs          AuditLog[]

  sessions           Session[]

  @@index([role])
  @@index([status])
}

// ─── SESSION ───────────────────────────────────────────
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── TENANT PROFILE ────────────────────────────────────
model TenantProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  phone                 String?
  profileImage          String?
  preferredLocation     String?
  minimumBudget         Float?
  maximumBudget         Float?
  preferredPropertyType String?  // APARTMENT | HOUSE | ROOM | SUBLET | HOSTEL | OFFICE | OTHER
  bedrooms              Int?
  bathrooms             Int?
  moveInDate            DateTime?
  occupancyType         String?  // FAMILY | BACHELOR | STUDENT | PROFESSIONAL | ROOMMATE | OTHER
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── LANDLORD PROFILE ──────────────────────────────────
model LandlordProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  phone              String?
  profileImage       String?
  verificationStatus String   @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  rejectionReason    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
}

// ─── PROPERTY ──────────────────────────────────────────
model Property {
  id              String   @id @default(cuid())
  ownerId         String
  title           String
  description     String?
  propertyType    String   // APARTMENT | HOUSE | ROOM | SUBLET | HOSTEL | OFFICE | OTHER
  status          String   @default("DRAFT") // DRAFT | PENDING_REVIEW | PUBLISHED | PAUSED | RENTED | EXPIRED | REJECTED
  address         String
  area            String?
  city            String
  latitude        Float?
  longitude       Float?
  rent            Float
  securityDeposit Float?
  bedrooms        Int
  bathrooms       Int
  size            Float?   // sq ft
  floor           Int?
  totalFloors     Int?
  availableFrom   DateTime?
  furnishingStatus String? // FURNISHED | SEMI_FURNISHED | UNFURNISHED
  parking         Boolean  @default(false)
  rules           String?
  rejectionReason String?
  changeRequestReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images         PropertyImage[]
  favorites      Favorite[]
  inquiries      Inquiry[]
  conversations  Conversation[]
  visitRequests  VisitRequest[]
  applications   RentalApplication[]
  tenancies      Tenancy[]
  maintenanceRequests MaintenanceRequest[]

  @@index([ownerId])
  @@index([status])
  @@index([city])
  @@index([propertyType])
  @@index([rent])
  @@index([bedrooms])
  @@index([createdAt])
}

// ─── PROPERTY IMAGE ────────────────────────────────────
model PropertyImage {
  id          String   @id @default(cuid())
  propertyId  String
  url         String
  storagePath String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ─── FAVORITE ──────────────────────────────────────────
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

// ─── INQUIRY ───────────────────────────────────────────
model Inquiry {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  landlordId String
  message    String
  status     String   @default("NEW") // NEW | VIEWED | RESPONDED | CLOSED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   User     @relation("TenantInquiries", fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  landlord User     @relation("LandlordInquiries", fields: [landlordId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@index([landlordId])
  @@index([status])
}

// ─── CONVERSATION ──────────────────────────────────────
model Conversation {
  id         String   @id @default(cuid())
  propertyId String
  tenantId   String
  landlordId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   User      @relation("TenantConversations", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord User      @relation("LandlordConversations", fields: [landlordId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([propertyId, tenantId, landlordId])
  @@index([tenantId])
  @@index([landlordId])
}

// ─── MESSAGE ───────────────────────────────────────────
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  message        String
  attachmentUrl  String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

// ─── VISIT REQUEST ─────────────────────────────────────
model VisitRequest {
  id            String   @id @default(cuid())
  tenantId      String
  propertyId    String
  landlordId    String
  requestedDate DateTime
  requestedTime String
  message       String?
  status        String   @default("REQUESTED") // REQUESTED | ACCEPTED | REJECTED | CANCELLED | COMPLETED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   User     @relation("TenantVisits", fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  landlord User     @relation("LandlordVisits", fields: [landlordId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@index([landlordId])
  @@index([status])
}

// ─── RENTAL APPLICATION ────────────────────────────────
model RentalApplication {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  landlordId String
  moveInDate DateTime?
  message    String?
  status     String   @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | WITHDRAWN
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   User     @relation("TenantApplications", fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  landlord User     @relation("LandlordApplications", fields: [landlordId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@index([landlordId])
  @@index([status])
}

// ─── TENANCY ───────────────────────────────────────────
model Tenancy {
  id              String   @id @default(cuid())
  tenantId        String
  propertyId      String
  landlordId      String
  startDate       DateTime
  endDate         DateTime?
  monthlyRent     Float
  securityDeposit Float?
  status          String   @default("PENDING") // PENDING | ACTIVE | ENDED | TERMINATED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    User     @relation("TenantTenancies", fields: [tenantId], references: [id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  landlord  User     @relation("LandlordTenancies", fields: [landlordId], references: [id], onDelete: Cascade)

  agreement          RentalAgreement?
  rentRecords        RentRecord[]
  payments           Payment[]
  maintenanceRequests MaintenanceRequest[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([landlordId])
  @@index([status])
}

// ─── RENTAL AGREEMENT ──────────────────────────────────
model RentalAgreement {
  id               String   @id @default(cuid())
  tenancyId        String   @unique
  documentUrl      String?
  startDate        DateTime
  endDate          DateTime?
  status           String   @default("DRAFT") // DRAFT | PENDING_SIGNATURE | ACTIVE | EXPIRED | TERMINATED
  signedByTenant   Boolean  @default(false)
  signedByLandlord Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
}

// ─── RENT RECORD ───────────────────────────────────────
model RentRecord {
  id            String    @id @default(cuid())
  tenancyId     String
  billingMonth  String    // YYYY-MM format
  dueDate       DateTime
  amount        Float
  paidAmount    Float     @default(0)
  status        String    @default("PENDING") // PENDING | PARTIAL | PAID | OVERDUE | WAIVED
  paidAt        DateTime?
  paymentMethod String?
  transactionId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenancy  Tenancy   @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([tenancyId, billingMonth])
  @@index([tenancyId])
  @@index([status])
  @@index([dueDate])
}

// ─── PAYMENT ───────────────────────────────────────────
model Payment {
  id                    String   @id @default(cuid())
  userId                String
  tenancyId             String
  rentRecordId          String?
  amount                Float
  currency              String   @default("BDT")
  provider              String?  // BKASH | NAGAD | SSLCOMMERZ | CARD | BANK_TRANSFER | CASH
  providerTransactionId String?
  status                String   @default("INITIATED") // INITIATED | PENDING | SUCCESS | FAILED | CANCELLED | REFUNDED
  metadata              String?  // JSON string
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenancy    Tenancy     @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  rentRecord RentRecord? @relation(fields: [rentRecordId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenancyId])
  @@index([rentRecordId])
  @@index([status])
}

// ─── MAINTENANCE REQUEST ───────────────────────────────
model MaintenanceRequest {
  id          String   @id @default(cuid())
  tenantId    String
  propertyId  String
  tenancyId   String
  title       String
  description String
  category    String   // PLUMBING | ELECTRICAL | AC | APPLIANCE | SECURITY | CLEANING | OTHER
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status      String   @default("OPEN") // OPEN | ACKNOWLEDGED | IN_PROGRESS | RESOLVED | CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenancy  Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  notes    MaintenanceNote[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([tenancyId])
  @@index([status])
  @@index([priority])
}

// ─── MAINTENANCE NOTE ──────────────────────────────────
model MaintenanceNote {
  id                   String   @id @default(cuid())
  maintenanceRequestId String
  authorId             String
  note                 String
  createdAt            DateTime @default(now())

  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  author               User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([maintenanceRequestId])
  @@index([authorId])
}

// ─── NOTIFICATION ──────────────────────────────────────
model Notification {
  id            String   @id @default(cuid())
  userId        String
  type          String   // NEW_INQUIRY | NEW_MESSAGE | VISIT_REQUEST | etc.
  title         String
  message       String
  referenceType String?
  referenceId   String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ─── REPORT ────────────────────────────────────────────
model Report {
  id          String    @id @default(cuid())
  reporterId  String
  targetType  String    // PROPERTY | USER
  targetId    String
  reason      String    // FAKE_LISTING | SCAM | INCORRECT_INFO | INAPPROPRIATE | DUPLICATE | SUSPICIOUS_USER
  description String?
  status      String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | DISMISSED
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
}

// ─── AUDIT LOG ─────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // PROPERTY_APPROVED | LANDLORD_VERIFIED | etc.
  entityType String
  entityId   String
  metadata   String?  // JSON string
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
